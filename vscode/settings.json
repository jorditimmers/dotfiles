{
    "update.mode": "none",
    "workbench.iconTheme": "symbols",
    "git.ignoreMissingGitWarning": true,
    "explorer.confirmDelete": false,
    "security.workspace.trust.untrustedFiles": "open",
    "security.workspace.trust.startupPrompt": "never",
    "[jsonc]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
    },
    "explorer.confirmDragAndDrop": false,
    "javascript.updateImportsOnFileMove.enabled": "always",
    "[javascript]": {
        "update.mode": "none",
        "editor.defaultFormatter": "esbenp.prettier-vscode",
    },
    "git.confirmSync": false,
    "git.autofetch": true,
    "[json]": {
        "update.mode": "none",
        "editor.defaultFormatter": "esbenp.prettier-vscode",
    },
    "[html]": {
        "update.mode": "none",
        "editor.defaultFormatter": "esbenp.prettier-vscode",
    },
    "[typescript]": {
        "update.mode": "none",
        "editor.defaultFormatter": "esbenp.prettier-vscode",
    },
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.inlineSuggest.enabled": true,
    "typescript.updateImportsOnFileMove.enabled": "always",
    "editor.fontFamily": "Geist Mono, JetBrains Mono,Menlo, Monaco, 'Courier New', monospace",
    "prettier.tabWidth": 4,
    "files.watcherExclude": {
        "update.mode": "none",
        "**/.bloop": true,
        "**/.metals": true,
        "**/.ammonite": true,
    },
    "terminal.integrated.fontFamily": "\"MesloLGS NF\"",

    //Delete from here if you want to revoke to default settings
    "editor.copyWithSyntaxHighlighting": false,
    "diffEditor.ignoreTrimWhitespace": false,
    "editor.emptySelectionClipboard": false,
    "workbench.editor.enablePreview": false,
    "window.newWindowDimensions": "inherit",
    "editor.multiCursorModifier": "alt",
    "files.trimTrailingWhitespace": true,
    "diffEditor.renderSideBySide": false,
    "editor.snippetSuggestions": "top",
    "editor.detectIndentation": true,
    "window.nativeFullScreen": true,
    "files.insertFinalNewline": true,
    "files.trimFinalNewlines": true,
    "editor.minimap.enabled": false,
    "editor.lineNumbers": "on",
    "diffEditor.renderGutterMenu": true,
    "editor.guides.indentation": true,
    "scm.diffDecorations": "all",
    "editor.hover.delay": 500,
    "editor.matchBrackets": "near",
    "workbench.tips.enabled": false,
    "editor.colorDecorators": false,
    "git.decorations.enabled": false,
    "editor.lightbulb.enabled": "off",
    "editor.selectionHighlight": false,
    "editor.overviewRulerBorder": false,
    "editor.renderLineHighlight": "none",
    "editor.occurrencesHighlight": "off",
    "problems.decorations.enabled": false,
    "editor.renderControlCharacters": false,
    "editor.hideCursorInOverviewRuler": true,
    "editor.gotoLocation.multipleReferences": "goto",
    "editor.gotoLocation.multipleDefinitions": "goto",
    "editor.gotoLocation.multipleDeclarations": "goto",
    "workbench.editor.enablePreviewFromQuickOpen": false,
    "editor.gotoLocation.multipleImplementations": "goto",
    "editor.gotoLocation.multipleTypeDefinitions": "goto",

    "editor.suggestFontSize": 13,
    "editor.suggestLineHeight": 20,
    "terminal.integrated.lineHeight": 1.2,
    "terminal.integrated.fontSize": 13,

    "search.useIgnoreFiles": false,
    "workbench.sideBar.location": "left",

    "editor.fontLigatures": "'ss01', 'ss02', 'ss03', 'ss04', 'ss05', 'ss06', 'ss07', 'ss08', 'calt', 'dlig'",
    "diffEditor.wordWrap": "on",
    "notebook.output.wordWrap": true,
    "editor.fontSize": 13,
    "editor.minimap.maxColumn": 250,
    "editor.accessibilitySupport": "off",
    "chat.editor.wordWrap": "on",
    "editor.wordWrap": "off",
    "editor.fontWeight": "400",
    "editor.inlineSuggest.suppressSuggestions": true,
    "editor.padding.top": 16,
    "editor.cursorBlinking": "solid",
    "editor.cursorStyle": "line",
    "editor.cursorWidth": 2,
    "editor.stickyScroll.enabled": false,
    "editor.lineHeight": 20,
    "workbench.tree.renderIndentGuides": "none",
    "editor.tokenColorCustomizations": {
        "update.mode": "none",
        "textMateRules": [
            {
                "update.mode": "none",
                "scope": [
                    "comment",
                    "comment.block",
                    "comment.block.documentation",
                    "comment.line",
                    "constant",
                    "constant.character",
                    "constant.character.escape",
                    "constant.numeric",
                    "constant.numeric.integer",
                    "constant.numeric.float",
                    "constant.numeric.hex",
                    "constant.numeric.octal",
                    "constant.other",
                    "constant.regexp",
                    "constant.rgb-value",
                    "emphasis",
                    "entity",
                    "entity.name",
                    "entity.name.class",
                    "entity.name.function",
                    "entity.name.method",
                    "entity.name.section",
                    "entity.name.selector",
                    "entity.name.tag",
                    "entity.name.type",
                    "entity.other",
                    "entity.other.attribute-name",
                    "entity.other.inherited-class",
                    "invalid",
                    "invalid.deprecated",
                    "invalid.illegal",
                    "keyword",
                    "keyword.control",
                    "keyword.operator",
                    "keyword.operator.new",
                    "keyword.operator.assignment",
                    "keyword.operator.arithmetic",
                    "keyword.operator.logical",
                    "keyword.other",
                    "markup",
                    "markup.bold",
                    "markup.changed",
                    "markup.deleted",
                    "markup.heading",
                    "markup.inline.raw",
                    "markup.inserted",
                    "markup.italic",
                    "markup.list",
                    "markup.list.numbered",
                    "markup.list.unnumbered",
                    "markup.other",
                    "markup.quote",
                    "markup.raw",
                    "markup.underline",
                    "markup.underline.link",
                    "meta",
                    "meta.block",
                    "meta.cast",
                    "meta.class",
                    "meta.function",
                    "meta.function-call",
                    "meta.preprocessor",
                    "meta.return-type",
                    "meta.selector",
                    "meta.tag",
                    "meta.type.annotation",
                    "meta.type",
                    "punctuation.definition.string.begin",
                    "punctuation.definition.string.end",
                    "punctuation.separator",
                    "punctuation.separator.continuation",
                    "punctuation.terminator",
                    "storage",
                    "storage.modifier",
                    "storage.type",
                    "string",
                    "string.interpolated",
                    "string.other",
                    "string.quoted",
                    "string.quoted.double",
                    "string.quoted.other",
                    "string.quoted.single",
                    "string.quoted.triple",
                    "string.regexp",
                    "string.unquoted",
                    "strong",
                    "support",
                    "support.class",
                    "support.constant",
                    "support.function",
                    "support.other",
                    "support.type",
                    "support.type.property-name",
                    "support.variable",
                    "variable",
                    "variable.language",
                    "variable.name",
                    "variable.other",
                    "variable.other.readwrite",
                    "variable.parameter",
                    "storage.type.ts",
                    "keyword.control.flow.ts",
                    "variable.parameter.tsx",
                    "meta.parameters.tsx",
                    "meta.type.function.tsx",
                    "meta.type.annotation.tsx",
                    "meta.field.declaration.tsx",
                    "meta.interface.tsx",
                    "source.tsx",
                    "entity.name.type.interface.tsx",
                    "meta.interface.tsx",
                    "source.tsx",
                ],
                "settings": {
                    "update.mode": "none",
                    "fontStyle": "",
                },
            },
        ],
    },
    "tailwindCSS.includeLanguages": {
        "update.mode": "none",
        "html": "html",
        "javascript": "javascript",
        "typescript": "typescript",
        "css": "css",
    },
    "editor.quickSuggestions": {
        "update.mode": "none",
        "strings": true,
    },
    "git.openRepositoryInParentFolders": "always",
    "extensions.ignoreRecommendations": true,
    "symbols.hidesExplorerArrows": true,
    "redhat.telemetry.enabled": true,
    "github.copilot.nextEditSuggestions.enabled": true,
    "chat.viewSessions.orientation": "stacked",
    "json.schemaDownload.trustedDomains": {
        "https://developer.microsoft.com/json-schemas/": true,
        "https://json-schema.org/": true,
        "https://json.schemastore.org/": true,
        "https://raw.githubusercontent.com/catppuccin/vscode/catppuccin-vsc-v3.19.0/packages/catppuccin-vsc/schemas/colorOverrides.schema.json": true,
        "https://raw.githubusercontent.com/devcontainers/spec/": true,
        "https://raw.githubusercontent.com/microsoft/vscode/": true,
        "https://schemastore.azurewebsites.net/": true,
        "https://www.schemastore.org/": true,
    },
    "workbench.secondarySideBar.defaultVisibility": "hidden",
    "[markdown]": {
        "diffEditor.ignoreTrimWhitespace": true,
    },
    "intellij.region": "europe",
    "intellij.dataSharing": "none",
    "workbench.colorTheme": "Aura Soft Dark",
    "[kotlin]": {
        "editor.autoIndent": "none",
        "editor.formatOnType": false,
    },
    "workbench.activityBar.location": "bottom",
}
